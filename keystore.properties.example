# Bu dosyayi "keystore.properties" olarak kopyala ve doldur.
# keystore.properties ve *.jks .gitignore'da; repoya asla girmez.
#
# Anahtar olusturma (bir kez, projenin kokunde):
#   keytool -genkey -v -keystore dosewear.jks -alias dosewear \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# ONEMLI: dosewear.jks dosyasini ve parolalari yedekle.
# Kaybedersen ayni imzayla guncelleme yapamazsin -> uygulamayi silip
# yeniden kurman gerekir, o da veritabanini (gecmis + stok) siler.

storeFile=dosewear.jks
storePassword=BURAYA_STORE_PAROLASI
keyAlias=dosewear
keyPassword=BURAYA_KEY_PAROLASI
